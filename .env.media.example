# ---- Existing Gemini voice setup ----
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
DEFAULT_VOICE=Charon

# ---- Server ----
PORT=8000
# IMPORTANT: For ChatGPT Actions/MCP this must be the HTTPS address ChatGPT can reach.
# For local-only testing leave 127.0.0.1. For actual ChatGPT use, set your HTTPS tunnel/domain.
PUBLIC_URL=http://127.0.0.1:8000

# Optional. If set, configure the same key as Bearer/API key in your Custom GPT Action.
SERVER_API_KEY=

# Large media limits
MAX_UPLOAD_MB=2048
MAX_REMOTE_IMPORT_MB=2048
PROCESS_TIMEOUT_SECONDS=7200

# FFmpeg binary names/paths
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ---- Optional Google Drive integration ----
# Preferred for a personal Google account: OAuth Desktop-app credentials.
# Download the OAuth client JSON, set this path, then run: python setup_google_drive.py
GOOGLE_OAUTH_CLIENT_JSON=google-oauth-client.json
GOOGLE_OAUTH_TOKEN_JSON=google-drive-token.json

# Alternative for Shared Drive/server setups:
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional default folder for Drive search/import/export. Blank = whole connected Drive/root upload.
GOOGLE_DRIVE_FOLDER_ID=
